# 로컬 백엔드를 직접 띄운 경우
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/ws

# ── 폰이나 다른 PC에서 `pnpm dev --host`로 접속하려면 ──
# 서버가 localhost 출처만 허용해서 `http://IP:5173`으로 접속하면 CORS에 막힙니다.
# 아래처럼 바꾸면 개발 서버가 요청을 대신 전달해 주고, 서버로 나갈 때 출처를 허용된 값으로 바꿉니다.
# (위의 두 줄은 지우거나 주석 처리하세요)
# VITE_API_BASE_URL=/api/v1
# VITE_WS_BASE_URL=/ws
# VITE_DEV_PROXY_TARGET=https://askeep-dev.onrender.com
